{
  "name": "planechase",
  "version": "1.1.0",
  "main": "node_modules/expo/AppEntry.js",
  "type": "commonjs",
  "scripts": {
    "pwa": "node ./util/pwa-asset-gen.js && webpack-cli",
    "dev:android": "expo start --android",
    "dev:ios": "expo start --ios",
    "dev:web": "expo start --web",
    "build": "npm run pwa && expo export -p web && node ./util/minify.js",
    "preview": "npm run build && wrangler pages dev",
    "deploy": "npm run build && wrangler pages deploy",
    "scryfall": "node ./util/update.js"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-picker/picker": "2.11.1",
    "@use-expo/screen-orientation": "^2.0.0",
    "expo": "^54.0.31",
    "expo-checkbox": "~5.0.8",
    "expo-dev-client": "~6.0.20",
    "expo-device": "~8.0.10",
    "expo-image": "~3.0.11",
    "expo-screen-orientation": "~9.0.8",
    "expo-status-bar": "~3.0.9",
    "pwa-asset-generator": "^8.1.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "^19.2.9",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "webpack-cli": "^6.0.1",
    "wrangler": "^4.59.3"
  },
  "private": true
}
